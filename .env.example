# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CHATWOOT CRM INTEGRATION (PHASE 1)
# Data provider mode: strictly 'local' (Demo In-Memory Fixtures) for validation/build testing
VITE_DATA_MODE="local"

# Chatwoot Backend Base URL (for future server-side proxying; not exposed via VITE_)
CHATWOOT_BASE_URL="http://127.0.0.1:3000"

# Chatwoot Tenant Account ID
VITE_CHATWOOT_ACCOUNT_ID="1"

# SECURITY DIRECTIVE:
# Any future Chatwoot API access tokens, Meta Cloud API tokens, webhook verify tokens,
# passwords, or private keys MUST remain server-side in backend environment variables.
# They MUST NEVER be prefixed with VITE_ or exposed to the client bundle.
